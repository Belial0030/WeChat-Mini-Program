.box{min-height:100vh;background:#f3f6fa;padding:24rpx 24rpx calc(144rpx + env(safe-area-inset-bottom));box-sizing:border-box}.datilist{background:#12364a;color:#fff;padding:30rpx;border-radius:22rpx}.datilist > view:first-child{font-size:33rpx;font-weight:600;line-height:1.5}.exam{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:24rpx;color:#d5e8ed;font-size:26rpx}.datilist-List{display:flex;align-items:center;gap:10rpx}.datidata{margin-top:24rpx;background:#fff;border:1rpx solid #e0e8ef;border-radius:22rpx;height:calc(100vh - 420rpx - env(safe-area-inset-bottom));min-height:400rpx;overflow:hidden}.swiper{width:100%;height:100%}.swiper-item{height:100%;padding:28rpx;box-sizing:border-box}.swiper-text{color:#475569;font-size:26rpx;line-height:1.6}.swiper-text > view:first-child{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.topic{color:#17243b;font-size:32rpx;line-height:1.85;margin:28rpx 0;white-space:normal;overflow-wrap:anywhere}.topic > text:first-child{color:#0f766e;font-weight:600;margin-right:10rpx}.swiper-list{width:100%;height:auto}.swiper-list label{display:flex;align-items:flex-start;gap:12rpx;min-height:96rpx;background:#f8fafc;border:1rpx solid #dce5ed;border-radius:14rpx;padding:24rpx 20rpx;margin-bottom:20rpx;font-size:28rpx;color:#334155;line-height:1.7}.swiper-list label > view{min-width:0;flex:1;overflow-wrap:anywhere}.swiper-list textarea{width:100%;min-height:280rpx;border:1rpx solid #dce5ed;background:#f8fafc;border-radius:14rpx;padding:24rpx;box-sizing:border-box}.swiper-item image{width:100%;margin-top:20rpx}.submit{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e0e8ef}.submit-item{margin:0;width:100%;min-height:92rpx;line-height:92rpx;background:#0f766e;color:#fff;border-radius:16rpx;font-size:30rpx}