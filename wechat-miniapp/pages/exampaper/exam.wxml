<view class="box"><view class="datilist"><view style="{{(viewStyles.style1)}}">{{''+exampaperName+''}}</view><view class="exam"><view class="datilist-List"><uni-icons vue-id="0b4f97ec-1" type="notification" size="30" bind:__l="__l"></uni-icons><text>{{SecondToDate}}</text></view><view class="datilist-List"><block wx:if="{{count>0}}"><text>考试中</text></block><block wx:else><text>考试结束</text></block></view></view></view><view class="datidata"><swiper class="swiper" interval="{{3000}}" duration="{{200}}"><block wx:for="{{dataList}}" wx:for-item="item" wx:for-index="index"><swiper-item><scroll-view class="swiper-item" scroll-y="true"><view class="swiper-text"><view style="{{(viewStyles.style2)}}"><text>{{item.examquestionValue+"/"+item.exampapertopicNumber+"分"}}</text><view class="datilist-List"><text style="{{(viewStyles.style3)}}"><text style="{{(viewStyles.style4)}}">{{index+1}}</text>/</text>{{$root.g0+''}}</view></view><view class="topic"><text>{{index+1+"、"}}</text><text>{{item.examquestionName}}</text></view></view><view class="swiper-list"><block wx:if="{{item.examquestionTypes==2}}"><checkbox-group class="swiper-list"><block wx:for="{{item.examquestionOptions}}" wx:for-item="io" wx:for-index="__i0__" wx:key="code"><label data-event-opts="{{[['tap',[['selectQuestions',['$0','$1'],[[['dataList','examquestionId||index',item.examquestionId||index,'examquestionId']],[['dataList','examquestionId||index',item.examquestionId||index],['examquestionOptions','code',io.code,'code']]]]]]]}}" style="{{(viewStyles.style5)}}" bindtap="__e"><checkbox value="{{io.code}}"></checkbox>{{io.code+'、'}}<view>{{io.text}}</view></label></block></checkbox-group></block><block wx:else><block wx:if="{{item.examquestionTypes==1||item.examquestionTypes==3}}"><radio-group class="swiper-list"><block wx:for="{{item.examquestionOptions}}" wx:for-item="io" wx:for-index="__i1__" wx:key="code"><label data-event-opts="{{[['tap',[['selectQuestions',['$0','$1'],[[['dataList','examquestionId||index',item.examquestionId||index,'examquestionId']],[['dataList','examquestionId||index',item.examquestionId||index],['examquestionOptions','code',io.code,'code']]]]]]]}}" style="{{(viewStyles.style6)}}" bindtap="__e"><radio value="{{io.code}}"></radio>{{io.code+'、'}}<view>{{io.text}}</view></label></block></radio-group></block><block wx:else><textarea style="{{(viewStyles.style7)}}" maxlength="-1" data-event-opts="{{[['input',[['__set_model',['$0','answer','$event',[]],['answerList.'+index+'']]]]]}}" value="{{answerList[index].answer}}" bindinput="__e"></textarea></block></block></view><view hidden="{{!(index===0)}}" style="{{(viewStyles.style8)}}"><image src="../../static/kaosi/tips.jpg" mode="aspectFit"></image></view></scroll-view></swiper-item></block></swiper></view><view class="submit"><button data-event-opts="{{[['tap',[['submitQuestions',['$event']]]]]}}" class="submit-item" bindtap="__e">提交试卷</button></view></view>