<view class="learning-community"><mescroll-uni vue-id="06630cd7-1" up="{{upOption}}" down="{{downOption}}" data-event-opts="{{[['^init',[['mescrollInit']]],['^down',[['downCallback']]],['^up',[['upCallback']]]]}}" bind:init="__e" bind:down="__e" bind:up="__e" bind:__l="__l" vue-slots="{{['default']}}"><view class="community-heading"><view>交流与分享</view><text>记录学习心得，一起提升安全意识。</text></view><view class="community-search"><view class="community-search-field"><text class="cuIcon-search"></text><input type="text" placeholder="搜索帖子标题" confirm-type="search" data-event-opts="{{[['confirm',[['search',['$event']]]],['input',[['__set_model',['$0','forumName','$event',[]],['searchForm']]]]]}}" value="{{searchForm.forumName}}" bindconfirm="__e" bindinput="__e"/></view><button data-event-opts="{{[['tap',[['search',['$event']]]]]}}" bindtap="__e">搜索</button></view><view class="community-posts"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['onDetailTap',['$0'],[[['list','id',item.$orig.id,'id']]]]]]]}}" class="community-post" bindtap="__e"><view class="community-post-heading"><text class="community-post-symbol cuIcon-message"></text><view class="community-post-title">{{item.$orig.forumName}}</view></view><view class="community-post-summary">{{item.g0>50?item.g1+'... ...':item.$orig.forumContent}}</view><view class="community-post-author"><block wx:if="{{item.$orig.yonghuId!=null}}"><text>{{"发布人："+item.$orig.yonghuName+"（用户）"}}</text></block><block wx:if="{{item.$orig.usersId!=null}}"><text>发布人：管理员</text></block><view class="community-role"><block wx:if="{{item.$orig.yonghuId!=null}}"><text>用户</text></block><block wx:if="{{item.$orig.usersId!=null}}"><text>管理员</text></block></view></view><view class="community-post-time">{{"发布时间："+item.$orig.insertTime}}</view></view></block></view></mescroll-uni><ai-assistant vue-id="06630cd7-2" bind:__l="__l"></ai-assistant></view>