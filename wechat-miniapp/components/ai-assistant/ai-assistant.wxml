<block wx:if="{{shouldShow}}"><view class="data-v-e634e084"><block wx:if="{{showFloatBtn}}"><view data-event-opts="{{[['tap',[['openChat',['$event']]]]]}}" class="ai-float-btn data-v-e634e084" bindtap="__e"><text class="ai-icon data-v-e634e084">AI</text></view></block><block wx:if="{{showChat}}"><view data-event-opts="{{[['tap',[['closeChat',['$event']]]]]}}" class="ai-chat-mask data-v-e634e084" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="ai-chat-window data-v-e634e084" catchtap="__e"><view class="ai-chat-header data-v-e634e084"><text class="ai-chat-title data-v-e634e084">网络安全学习助手</text><text data-event-opts="{{[['tap',[['closeChat',['$event']]]]]}}" class="ai-chat-close data-v-e634e084" bindtap="__e">×</text></view><scroll-view class="ai-chat-content data-v-e634e084" scroll-y="{{true}}" scroll-top="{{scrollTop}}"><block wx:for="{{messages}}" wx:for-item="msg" wx:for-index="index" wx:key="index"><view class="{{['data-v-e634e084','ai-msg',msg.role==='user'?'ai-msg-user':'ai-msg-ai']}}"><view class="ai-msg-text data-v-e634e084">{{msg.content}}</view></view></block><block wx:if="{{loading}}"><view class="ai-msg ai-msg-ai data-v-e634e084"><view class="ai-msg-text data-v-e634e084">正在思考中...</view></view></block></scroll-view><view class="ai-chat-input data-v-e634e084"><input class="ai-input data-v-e634e084" placeholder="例如：如何识别钓鱼短信？" data-event-opts="{{[['confirm',[['sendMessage',['$event']]]],['input',[['__set_model',['','inputMessage','$event',[]]]]]]}}" value="{{inputMessage}}" bindconfirm="__e" bindinput="__e"/><button class="ai-send-btn data-v-e634e084" disabled="{{$root.g0}}" data-event-opts="{{[['tap',[['sendMessage',['$event']]]]]}}" bindtap="__e">发送</button></view></view></view></block></view></block>